# Fara Agent — environment for the cloud VM.
# Copy to scripts/cloud/fara.env on the VM and fill in your values:
#
#     cp scripts/cloud/fara.env.example scripts/cloud/fara.env
#
# systemd reads this file literally: no shell expansion, so $HOME and ~
# do NOT work here. The paths below assume the VM user is `ubuntu` and the
# code lives in /home/ubuntu/web-agent (what setup-vm.sh creates). If your
# user is different:
#
#     sed -i 's#/home/ubuntu#/home/YOURUSER#g' scripts/cloud/fara.env
#
# and do the same in scripts/cloud/fara-agent.service.

# --- Model: any OpenAI-compatible chat-completions endpoint with vision ---
FARA_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
FARA_MODEL=gemini-2.0-flash
FARA_API_KEY=

# --- Context budget (cloud APIs have far bigger windows than the local 27B) ---
FARA_TOKEN_BUDGET=120000

# --- Paths and browser container (must match the VM user's home) ---
FARA_HOME=/home/ubuntu/web-agent
FARA_DATA_DIR=/home/ubuntu/web-agent/fixtures/pw
FARA_LOG_ROOT=/home/ubuntu/web-agent/var/logs/pw
FARA_CONTAINER=fara-browser-pw
FARA_CDP_URL=http://127.0.0.1:9333

# --- Telegram notifications ---
# agent/telegram_config.py is imported directly, nothing to set here.
