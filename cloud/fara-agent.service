# systemd service — keeps Fara running on the cloud VM at all times.
# Install:
#   sudo cp ~/web-agent/cloud/fara-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable fara-agent
#   sudo systemctl start fara-agent

[Unit]
Description=Fara Agent GUI Server
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/web-agent/controller_pw
EnvironmentFile=/home/ubuntu/web-agent/cloud/fara.env
ExecStartPre=/usr/bin/docker start fara-browser-pw
ExecStart=/home/ubuntu/web-agent/venv_pw/bin/python gui_server.py --port 8766
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/web-agent/logs_pw/gui_server.out
StandardError=append:/home/ubuntu/web-agent/logs_pw/gui_server.out

[Install]
WantedBy=multi-user.target
